---
export const prerender = false;

import Painel from '../../layouts/Painel.astro';
import { paraLogin, texto, type Conta } from '../../lib/painel';
import { verDepois } from '../../lib/api';

let erro: string | null = null;
let campos: Record<string, string> = {};
let form: any = null;

if (Astro.request.method === 'POST') {
  let d: FormData;
  try {
    d = await Astro.request.formData();
  } catch {
    // POST sem corpo de formulario. Responde 400 e para por aqui: redirecionar
    // para a propria URL fazia um cliente que repete o POST girar sem fim.
    return new Response('Requisicao invalida.', { status: 400 });
  }
  form = {
    nome: texto(d, 'nome'),
    telefonePrincipal: texto(d, 'telefonePrincipal'),
    telefoneSecundario: texto(d, 'telefoneSecundario'),
    whatsapp: texto(d, 'whatsapp'),
  };
  const r = await Astro.locals.api('/api/me', { metodo: 'PUT', corpo: form });
  if (r.status === 401) return paraLogin(Astro);
  if (r.ok) return verDepois('/app/conta?salvo=1');
  erro = r.erro;
  campos = r.campos;
}

const rc = await Astro.locals.api<Conta>('/api/me');
if (rc.status === 401) return paraLogin(Astro);
if (!rc.ok) return paraLogin(Astro);

const conta = rc.dados!;
// O formulário mostra o número formatado, mas o que a pessoa acabou de digitar
// vem antes: reescrever por cima do que ela escreveu seria perder o trabalho.
const v = {
  nome: form?.nome ?? conta.nome,
  telefonePrincipal: form?.telefonePrincipal ?? conta.telefonePrincipalExibicao ?? '',
  telefoneSecundario: form?.telefoneSecundario ?? conta.telefoneSecundarioExibicao ?? '',
  whatsapp: form?.whatsapp ?? conta.whatsappExibicao ?? '',
};
const salvo = Astro.url.searchParams.has('salvo');
---

<Painel titulo="Minha conta" aba="conta">
  <h1>Minha conta</h1>
  <p class="sub">
    Estes telefones são os que aparecem na página do seu pet, quando você deixa
    cada um deles visível.
  </p>

  {salvo && <p class="sucesso" role="status"><span>Dados salvos.</span></p>}
  {erro && <p class="aviso" role="alert"><span>{erro}</span></p>}

  <form class="cartao" method="POST">
    <div class="campo">
      <label for="nome">Seu nome</label>
      <input id="nome" name="nome" required minlength="2" maxlength="120" value={v.nome}
             aria-invalid={campos.nome ? 'true' : undefined} />
      {campos.nome && <p class="erro-campo">{campos.nome}</p>}
      <p class="ajuda">É este nome que aparece no “Ligar para…” da página pública.</p>
    </div>

    <div class="campo">
      <label for="telefonePrincipal">Telefone principal</label>
      <input id="telefonePrincipal" name="telefonePrincipal" type="tel" inputmode="tel"
             placeholder="(11) 99999-0000" value={v.telefonePrincipal}
             aria-invalid={campos.telefonePrincipal ? 'true' : undefined} />
      {campos.telefonePrincipal && <p class="erro-campo">{campos.telefonePrincipal}</p>}
    </div>

    <div class="campo">
      <label for="whatsapp">WhatsApp</label>
      <input id="whatsapp" name="whatsapp" type="tel" inputmode="tel"
             placeholder="(11) 99999-0000" value={v.whatsapp}
             aria-invalid={campos.whatsapp ? 'true' : undefined} />
      {campos.whatsapp && <p class="erro-campo">{campos.whatsapp}</p>}
      <p class="ajuda">Pode ser o mesmo do telefone principal.</p>
    </div>

    <div class="campo">
      <label for="telefoneSecundario">Telefone alternativo</label>
      <input id="telefoneSecundario" name="telefoneSecundario" type="tel" inputmode="tel"
             placeholder="(11) 3333-0000" value={v.telefoneSecundario}
             aria-invalid={campos.telefoneSecundario ? 'true' : undefined} />
      {campos.telefoneSecundario && <p class="erro-campo">{campos.telefoneSecundario}</p>}
    </div>

    <button class="btn btn--principal" type="submit">Salvar</button>
  </form>

  <section class="cartao">
    <h2 class="cartao__titulo">E-mail e plano</h2>
    <ul class="lista-limpa">
      <li class="item">
        <p class="item__quando">E-mail</p>
        <p class="item__oque">{conta.email}</p>
        <p class="item__quando">
          Trocar o e-mail muda a forma de recuperar a conta, então ainda não é
          feito por aqui — fale com a gente.
        </p>
      </li>
      <li class="item">
        <p class="item__quando">Plano</p>
        <p class="item__oque">{conta.plano === 'PLUS' ? 'Plus' : 'Free'}</p>
      </li>
    </ul>
  </section>

  <p class="rodape-link"><a class="link" href="/sair">Sair da conta</a></p>
</Painel>
