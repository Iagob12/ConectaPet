---
// Pagina de resgate. A tela mais importante do produto.
//
// Contexto de uso: um estranho, na rua, com o pet no colo, no sol, em rede
// ruim, no celular dele. Tudo aqui e subordinado a isso.
//
// Renderizada no servidor: o HTML util chega na primeira resposta. `tel:` e
// `wa.me` funcionam sem JavaScript nenhum — so a partilha de localizacao
// depende de script.
export const prerender = false;

const { codigo } = Astro.params;
// Dois enderecos para a mesma API, e a diferenca importa em producao.
//
// API_URL e usado por ESTE servidor: em producao aponta para o nome interno do
// container, sem sair para a internet. Dar a volta pelo dominio publico faria
// a pagina depender de DNS externo e do proprio proxy para falar com um
// servico que esta na maquina ao lado.
//
// API_URL_PUBLICA e o que vai para o NAVEGADOR — a foto e a confirmacao de
// leitura sao buscadas por ele, nao por aqui. Precisa ser alcancavel de fora.
// Em desenvolvimento os dois sao o mesmo, e basta definir API_URL.
//
// process.env antes de import.meta.env: o segundo e congelado no build.
const ambiente = typeof process !== 'undefined' ? process.env : ({} as Record<string, string>);
const API = ambiente.API_URL ?? import.meta.env.API_URL ?? 'http://localhost:8080';
const API_PUBLICA = ambiente.API_URL_PUBLICA ?? API;

let perfil = null;
let falhou = false;

/**
 * Duas tentativas, com teto de tempo em cada uma.
 *
 * O teto existe porque a falha que trava e pior que a falha que avisa: sem
 * ele, uma API lenta (e nao recusada) deixa a pessoa olhando uma tela em
 * branco por tempo indefinido, com o pet no colo, sem saber se vale esperar.
 * Quatro segundos e mais do que qualquer resposta saudavel leva.
 *
 * A segunda tentativa cobre a queda de um instante, que e a mais comum. Duas e
 * o limite: a terceira ja custa mais espera do que resolve.
 */
for (let tentativa = 0; tentativa < 2 && !perfil; tentativa++) {
  try {
    const r = await fetch(`${API}/api/public/tags/${encodeURIComponent(codigo ?? '')}`, {
      headers: { 'User-Agent': Astro.request.headers.get('user-agent') ?? '' },
      signal: AbortSignal.timeout(4000),
    });
    if (r.ok) {
      perfil = await r.json();
      falhou = false;
    } else {
      falhou = true;
    }
  } catch {
    falhou = true;
  }
}

const ativo = perfil?.estado === 'ATIVO';

/**
 * Tag sem perfil vai direto para o cadastro.
 *
 * O codigo ja veio na URL, entao a pagina nao precisa perguntar nada para
 * saber o que fazer: se ha perfil, mostra; se nao ha, comeca o cadastro.
 *
 * A indistinguibilidade continua de pe — codigo inexistente e codigo nao
 * ativado seguem para o mesmo lugar, entao a tela nao vira um verificador de
 * quais codigos existem.
 */
if (!falhou && !ativo) {
  return Astro.redirect(`/ativar?codigo=${codigo}`, 302);
}
const pet = perfil?.pet;
const tutor = perfil?.tutor;
const saude = perfil?.saude;
const contatos = perfil?.contatosEmergencia;
const perdido = perfil?.modoPerdido === true;

// Mensagem pre-preenchida: quem encontrou nao deveria ter que pensar no que
// escrever com um cachorro desconhecido no colo.
const msgWhats = encodeURIComponent(`Ola! Encontrei ${pet?.nome ?? 'seu pet'}.`);

// A API devolve caminho relativo; ela e quem serve a foto, sob a mesma regra de
// visibilidade do perfil.
const foto = pet?.foto?.media ? `${API_PUBLICA}${pet.foto.media}` : null;

Astro.response.headers.set('Cache-Control', 'no-store');
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow');
---

<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <!-- Um perfil com o telefone do tutor indexado no Google e o pior desfecho possivel. -->
  <meta name="robots" content="noindex, nofollow" />
  <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <title>{ativo ? `${pet.nome} — ConectaPet` : 'ConectaPet'}</title>
  <style>
    :root {
      --teal-500:#2FA8A5; --teal-600:#248785; --teal-700:#1D6B69; --teal-100:#D9F0EF;
      --orange-500:#F0A02E; --orange-100:#FCEBD2;
      --navy-900:#22313A; --navy-700:#3B4E59;
      --white:#FFFFFF; --sand-100:#FAF3E7; --gray-300:#D6D2C9;
      --call-600:#0E8449; --whats-700:#0F7A6E;
      --alert-600:#D92D20; --alert-50:#FEF0EF;
    }
    *,*::before,*::after{box-sizing:border-box}
    body{
      margin:0; background:var(--white); color:var(--navy-700);
      /* Sem moldura: cada pixel serve ao botao de ligar. */
      font:400 17px/1.55 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
    }
    /* O mesmo cabecalho funcional da pagina inicial, mas sempre sobre fundo
       branco: nesta tela o topo nao flutua sobre o hero. */
    .site-header{
      position:sticky;top:0;z-index:60;background:var(--white);
      border-bottom:1px solid var(--gray-300);box-shadow:0 4px 12px rgba(34,49,58,.08);
    }
    .nav-wrap{
      max-width:1180px;min-height:68px;margin:0 auto;padding:8px 20px;
      display:flex;align-items:center;gap:16px;
    }
    .site-brand{
      display:inline-flex;align-items:center;gap:10px;min-height:44px;
      margin-right:auto;text-decoration:none;color:inherit;
    }
    .site-brand img{width:46px;height:auto;flex:none}
    .site-brand__texto{display:flex;flex-direction:column;line-height:1}
    .site-brand__nome{font:800 20px/1 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;
      letter-spacing:-.02em;color:var(--navy-900)}
    .site-brand__nome span{color:var(--teal-600)}
    .site-brand__slogan{font-size:11px;color:var(--navy-700);margin-top:4px;letter-spacing:.02em}
    .nav-principal,.nav-acoes{display:none}
    .nav-lista{display:flex;align-items:center;gap:2px;list-style:none;margin:0;padding:0}
    .nav-lista a,.nav-acao{
      display:inline-flex;align-items:center;justify-content:center;min-height:44px;
      padding:0 13px;border-radius:9999px;color:var(--navy-900);
      text-decoration:none;font-size:15px;font-weight:600;white-space:nowrap;
    }
    .nav-lista a:hover,.nav-acao:hover{background:var(--teal-100);color:var(--teal-700)}
    .nav-acao--principal{
      background:var(--teal-500);border:2px solid var(--navy-900);
      box-shadow:2px 2px 0 var(--navy-900);padding-inline:18px;
    }
    .nav-acao--principal:active{transform:translate(2px,2px);box-shadow:none}
    .nav-toggle{
      display:inline-flex;align-items:center;justify-content:center;gap:7px;
      min-width:48px;height:48px;padding:0 13px;background:var(--white);
      color:var(--navy-900);border:2px solid var(--navy-900);border-radius:9999px;
      font:600 15px/1 system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;cursor:pointer;
    }
    .nav-toggle:hover{background:var(--navy-900);color:#fff}
    .nav-toggle .icone-fechar{display:none}
    .nav-toggle[aria-expanded="true"] .icone-menu{display:none}
    .nav-toggle[aria-expanded="true"] .icone-fechar{display:block}
    .nav-drawer{background:var(--white);border-top:1px solid var(--gray-300);padding:0 20px}
    .nav-drawer[hidden]{display:none}
    .nav-drawer__conteudo{max-width:520px;margin:0 auto;padding:8px 0 20px}
    .nav-drawer__lista{list-style:none;margin:0;padding:0}
    .nav-drawer__lista a{
      display:flex;align-items:center;min-height:52px;padding:8px 4px;
      border-bottom:1px solid var(--gray-300);color:var(--navy-900);
      text-decoration:none;font-weight:600;
    }
    .nav-drawer__lista a:hover{color:var(--teal-700)}
    .nav-drawer__acoes{display:grid;gap:10px;padding-top:16px}
    .nav-drawer__acoes .nav-acao{border:2px solid var(--navy-900)}
    @media (min-width:1024px){
      .nav-principal{display:block}
      .nav-acoes{display:flex;align-items:center;gap:4px}
      .nav-toggle{display:none}
      .nav-drawer{display:none!important}
    }
    .folha{max-width:520px;margin:0 auto;padding:0 20px 40px}

    /* 1. Faixa de alerta */
    .alerta{
      display:flex;gap:12px;align-items:flex-start;
      background:var(--alert-50);border-top:4px solid var(--alert-600);
      margin:0 -20px 20px;padding:16px 20px;
      color:var(--navy-900);font-size:18px;font-weight:600;line-height:1.35;
    }
    .alerta svg{flex:none;color:var(--alert-600);margin-top:2px}

    /* 2. Foto e nome */
    .cartao-pet{
      background:var(--white);border:2px solid var(--navy-900);
      border-radius:28px;overflow:hidden;box-shadow:4px 4px 0 var(--navy-900);
      margin-top:20px;
    }
    .cartao-pet img{display:block;width:100%;aspect-ratio:4/3;object-fit:cover}
    .sem-foto{
      aspect-ratio:4/3;background:var(--orange-100);
      display:flex;align-items:center;justify-content:center;color:var(--navy-900);
    }
    .nome{margin:16px 16px 4px;font-size:28px;font-weight:800;color:var(--navy-900);line-height:1.15}
    .meta{margin:0 16px 16px;font-size:16px;color:var(--navy-700)}

    /* 3-5. Botoes: solidos, largura total, alvo grande */
    .acoes{margin-top:20px;display:grid;gap:12px}
    .btn{
      display:flex;align-items:center;justify-content:center;gap:10px;
      min-height:64px;border-radius:9999px;border:2px solid var(--navy-900);
      font-size:18px;font-weight:600;text-decoration:none;color:#fff;
      box-shadow:3px 3px 0 var(--navy-900);
    }
    .btn:active{transform:translate(3px,3px);box-shadow:none}
    .btn--ligar{background:var(--call-600)}
    .btn--whats{background:var(--whats-700)}
    .btn--local{background:var(--white);color:var(--navy-900);min-height:56px}
    .btn[hidden]{display:none}

    /* 6-7. Blocos de informacao, sempre abertos */
    .bloco{
      margin-top:20px;background:var(--sand-100);
      border:2px solid var(--navy-900);border-radius:20px;padding:16px;
    }
    .bloco h2{margin:0 0 8px;font-size:16px;font-weight:700;color:var(--navy-900);
      letter-spacing:.06em;text-transform:uppercase}
    .bloco dl{margin:0;display:grid;gap:8px}
    .bloco dt{font-weight:600;color:var(--navy-900);font-size:15px}
    .bloco dd{margin:0 0 4px;font-size:17px}
    .contato{display:flex;justify-content:space-between;gap:12px;align-items:center;
      padding:10px 0;border-top:1px solid var(--gray-300)}
    .contato:first-of-type{border-top:0}
    .contato a{color:var(--teal-700);font-weight:600;white-space:nowrap}
    .recado{margin-top:16px;padding:14px 16px;background:var(--teal-100);
      border:2px solid var(--navy-900);border-radius:20px;color:var(--navy-900)}

    /* 8. Assinatura discreta depois que o resgate foi resolvido. */
    .rodape{margin-top:32px;text-align:center;font-size:14px;color:var(--navy-700)}

    .aviso{margin-top:24px;text-align:center}
    .aviso h1{font-size:24px;color:var(--navy-900);margin:0 0 12px}
    .aviso p{max-width:38ch;margin:0 auto 20px}
    .aviso a{display:inline-flex;align-items:center;min-height:56px;padding:0 28px;
      border-radius:9999px;background:var(--teal-500);color:var(--navy-900);
      border:2px solid var(--navy-900);box-shadow:3px 3px 0 var(--navy-900);
      font-weight:600;text-decoration:none}
    #status-local{margin-top:8px;font-size:15px;text-align:center;min-height:22px}

  /* Grande e selecionavel: a pessoa pode precisar copiar isto a mao. */
  .codigo-tag{display:block;margin:24px auto;padding:16px;background:var(--sand-100);
    border:2px solid var(--navy-900);border-radius:20px}
  .codigo-tag span{display:block;font-size:14px;color:var(--navy-700);margin-bottom:6px}
  .codigo-tag strong{font-family:ui-monospace,SFMono-Regular,Menlo,monospace;
    font-size:26px;letter-spacing:.16em;color:var(--navy-900);word-break:break-all}
    /* Foco visivel, declarado e nao herdado do navegador.
       O anel padrao e desenhado com a cor do texto do elemento: sobre os
       botoes escuros de ligar e WhatsApp ele quase desaparece. Aqui o anel e
       navy com afastamento, entao ele cai no fundo claro da pagina e mantem
       contraste alto contra qualquer um dos botoes. Vale para quem navega por
       teclado e para quem usa controle adaptativo — que e justamente parte de
       quem pode achar um cachorro na rua. */
    :focus-visible{outline:3px solid var(--navy-900);outline-offset:3px;border-radius:4px}
    .btn:focus-visible{outline-offset:4px}
    @media (prefers-reduced-motion:reduce){*{transition:none!important}}
  </style>
</head>
<body>
  <header class="site-header">
    <div class="nav-wrap">
      <a class="site-brand" href="/" aria-label="ConectaPet — ir para a página inicial">
        <img src="/marca.png" srcset="/marca.png 1x, /marca@2x.png 2x"
             width="46" height="42" alt="" decoding="async" />
        <span class="site-brand__texto">
          <span class="site-brand__nome">Conecta<span>Pet</span></span>
          <span class="site-brand__slogan">Aproxima e Protege</span>
        </span>
      </a>

      <nav class="nav-principal" aria-label="Menu principal">
        <ul class="nav-lista">
          <li><a href="/#como-funciona">Como funciona</a></li>
          <li><a href="/#petshops">Para petshops</a></li>
          <li><a href="/#faq">Ajuda</a></li>
        </ul>
      </nav>

      <div class="nav-acoes">
        <a class="nav-acao" href="/ativar">Ativar minha tag</a>
        <a class="nav-acao" href="/entrar">Entrar</a>
        <a class="nav-acao nav-acao--principal" href="/#chamada-final">Quero minha tag</a>
      </div>

      <button class="nav-toggle" type="button" id="menu-btn" aria-expanded="false"
              aria-controls="menu-mobile">
        <svg class="icone-menu" width="22" height="22" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16" />
        </svg>
        <svg class="icone-fechar" width="22" height="22" viewBox="0 0 24 24" fill="none"
             stroke="currentColor" stroke-width="2.5" stroke-linecap="round" aria-hidden="true">
          <path d="M6 6l12 12M18 6L6 18" />
        </svg>
        <span>Menu</span>
      </button>
    </div>

    <div class="nav-drawer" id="menu-mobile" hidden>
      <nav class="nav-drawer__conteudo" aria-label="Menu principal (celular)">
        <ul class="nav-drawer__lista">
          <li><a href="/#como-funciona">Como funciona</a></li>
          <li><a href="/#petshops">Para petshops</a></li>
          <li><a href="/#faq">Ajuda</a></li>
        </ul>
        <div class="nav-drawer__acoes">
          <a class="nav-acao" href="/ativar">Ativar minha tag</a>
          <a class="nav-acao" href="/entrar">Entrar</a>
          <a class="nav-acao nav-acao--principal" href="/#chamada-final">Quero minha tag</a>
        </div>
      </nav>
    </div>
  </header>
  <main class="folha">

    {ativo && perdido && (
      <p class="alerta">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor"
             stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M12 4l9 15.5H3L12 4z"/><path d="M12 10v4M12 17h.01"/>
        </svg>
        <span>ESTE PET ESTÁ PERDIDO</span>
      </p>
    )}

    {ativo ? (
      <>
        <div class="cartao-pet">
          {foto
            ? <img src={foto} alt={`Foto de ${pet.nome}`} width="400" height="300" />
            : <div class="sem-foto" aria-hidden="true">
                <svg width="72" height="72" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                  <circle cx="7.3" cy="9.2" r="1.9"/><circle cx="12" cy="7.4" r="1.9"/>
                  <circle cx="16.7" cy="9.2" r="1.9"/>
                  <path d="M12 12.4c3 0 5.2 2 5.2 4.3S15 20.6 12 20.6s-5.2-1.6-5.2-3.9S9 12.4 12 12.4z"/>
                </svg>
              </div>}
          <h1 class="nome">{pet.nome}</h1>
          <p class="meta">
            {[pet.raca, pet.cor, pet.pesoKg ? `${pet.pesoKg} kg` : null,
              pet.cidade ? `${pet.cidade}${pet.estado ? ', ' + pet.estado : ''}` : null]
              .filter(Boolean).join(' · ')}
          </p>
        </div>

        <div class="acoes">
          {tutor?.telefoneE164 && (
            <a class="btn btn--ligar" href={`tel:${tutor.telefoneE164}`}>
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                   stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M6.5 3h3l1.6 4-2.1 1.6a12 12 0 006.4 6.4L17 12.9l4 1.6v3a2 2 0 01-2.2 2A16.6 16.6 0 014.5 5.2 2 2 0 016.5 3z"/>
              </svg>
              Ligar para {tutor.nome}
            </a>
          )}

          {tutor?.whatsappE164 && (
            <a class="btn btn--whats" href={`https://wa.me/${tutor.whatsappE164}?text=${msgWhats}`}>
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                   stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M20.5 11.6a8.5 8.5 0 01-12.7 7.4L3.5 20.5l1.6-4.2A8.5 8.5 0 1120.5 11.6z"/>
              </svg>
              Chamar no WhatsApp
            </a>
          )}

          <button class="btn btn--local" id="btn-local" type="button" hidden>
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 21.2s7-6.5 7-11.2a7 7 0 10-14 0c0 4.7 7 11.2 7 11.2z"/><circle cx="12" cy="10" r="2.6"/>
            </svg>
            Avisar onde encontrei
          </button>
          <p id="status-local" role="status" aria-live="polite"></p>
        </div>

        {saude && (
          <section class="bloco">
            <h2>Informações de saúde</h2>
            <dl>
              {saude.alergias && <><dt>Alergias</dt><dd>{saude.alergias}</dd></>}
              {saude.medicacaoContinua && <><dt>Medicação contínua</dt><dd>{saude.medicacaoContinua}</dd></>}
              {saude.condicoes && <><dt>Condições</dt><dd>{saude.condicoes}</dd></>}
              {saude.cuidadosEspeciais && <><dt>Cuidados especiais</dt><dd>{saude.cuidadosEspeciais}</dd></>}
              {saude.veterinarioNome && (
                <><dt>Veterinário</dt>
                  <dd>{saude.veterinarioNome}
                    {saude.veterinarioTelefoneE164 &&
                      <> — <a href={`tel:${saude.veterinarioTelefoneE164}`}>{saude.veterinarioTelefoneExibicao}</a></>}
                  </dd></>
              )}
            </dl>
          </section>
        )}

        {contatos && contatos.length > 0 && (
          <section class="bloco">
            <h2>Contatos de emergência</h2>
            {contatos.map((c) => (
              <div class="contato">
                <span>{c.nome}{c.parentesco ? ` · ${c.parentesco}` : ''}</span>
                <a href={`tel:${c.telefoneE164}`}>{c.telefoneExibicao}</a>
              </div>
            ))}
          </section>
        )}

        {perfil.mensagemPersonalizada && <p class="recado">{perfil.mensagemPersonalizada}</p>}
      </>
    ) : falhou ? (
      /* O problema e nosso, e a tela diz isso.
         "Verifique sua conexao" era falso e caro: a pagina so chegou ate aqui
         porque a conexao da pessoa funciona. Mandar conferir o proprio celular
         faz quem esta na rua com um pet desconhecido concluir que o aparelho
         falhou, tentar de novo no escuro e desistir.
         O codigo aparece grande porque e a unica coisa que ainda serve: com ele
         anotado, o resgate continua possivel mesmo que esta tela nunca carregue. */
      <div class="aviso">
        <h1>Nossos servidores não responderam</h1>
        <p>
          O problema é do nosso lado, não do seu celular. Já tentamos duas
          vezes automaticamente.
        </p>
        <p class="codigo-tag">
          <span>Anote o código desta tag</span>
          <strong>{codigo}</strong>
        </p>
        <p>
          Com ele, dá para nos avisar depois e chegar ao dono do pet.
          Tente recarregar em alguns minutos.
        </p>
        <a href={`/p/${codigo}`}>Tentar de novo</a>
      </div>
    ) : null}

    <p class="rodape">
      ConectaPet · Aproxima e Protege
    </p>
  </main>

  {/* API_PUBLICA, nao API: este script roda no NAVEGADOR de quem achou o pet,
      e o nome interno do container nao existe para ele. */}
  <script define:vars={{ codigo, API: API_PUBLICA }}>
    // O cabecalho e o mesmo da vitrine, inclusive no celular. Ele continua
    // sendo navegavel se a API do perfil falhar.
    const botaoMenu = document.getElementById('menu-btn');
    const menuMobile = document.getElementById('menu-mobile');
    const definirMenu = (aberto) => {
      if (!botaoMenu || !menuMobile) return;
      botaoMenu.setAttribute('aria-expanded', String(aberto));
      menuMobile.hidden = !aberto;
    };
    if (botaoMenu && menuMobile) {
      botaoMenu.addEventListener('click', () =>
        definirMenu(botaoMenu.getAttribute('aria-expanded') !== 'true'));
      menuMobile.addEventListener('click', (evento) => {
        if (evento.target instanceof Element && evento.target.closest('a')) definirMenu(false);
      });
      document.addEventListener('keydown', (evento) => {
        if (evento.key === 'Escape' && botaoMenu.getAttribute('aria-expanded') === 'true') {
          definirMenu(false);
          botaoMenu.focus();
        }
      });
    }

    // A unica coisa nesta pagina que depende de JavaScript.
    //
    // Dois papeis: confirmar que quem abriu e gente (o beacon e a UNICA entrada
    // que notifica o tutor — robo de preview de link nao executa script), e
    // enviar a localizacao SE a pessoa tocar no botao.
    const enviar = (corpo) =>
      fetch(`${API}/api/public/tags/${codigo}/leituras`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(corpo ?? {}),
        keepalive: true,
      }).catch(() => {});

    // Confirma a leitura humana. Se falhar, a pagina nao pode quebrar.
    enviar(null);

    const botao = document.getElementById('btn-local');
    const status = document.getElementById('status-local');
    if (botao && 'geolocation' in navigator) {
      botao.hidden = false;
      botao.addEventListener('click', () => {
        // A permissao so e pedida no toque, nunca ao abrir a pagina.
        status.textContent = 'Enviando sua localização aproximada ao tutor…';
        botao.disabled = true;
        navigator.geolocation.getCurrentPosition(
          (pos) => {
            enviar({
              localizacaoCompartilhada: true,
              latitude: pos.coords.latitude,
              longitude: pos.coords.longitude,
              precisaoM: Math.round(pos.coords.accuracy),
            });
            status.textContent = 'Pronto, avisamos o tutor. Obrigado por ajudar.';
          },
          () => {
            status.textContent = 'Sem problema — os botões acima continuam funcionando.';
            botao.disabled = false;
          },
          { timeout: 10000, maximumAge: 60000 }
        );
      });
    }
  </script>
</body>
</html>
