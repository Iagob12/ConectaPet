---
export const prerender = false;

import Admin from '../../layouts/Admin.astro';
import { exigirAdmin, MODELOS, type Lote, type Metricas } from '../../lib/admin';
import { quando, dia } from '../../lib/painel';
import { verDepois } from '../../lib/api';

const porta = await exigirAdmin(Astro);
if ('resposta' in porta) return porta.resposta;

let erro: string | null = null;
let campos: Record<string, string> = {};
let form = { nome: '', quantidade: '50', modelo: 'CLASSICA', observacoes: '' };

if (Astro.request.method === 'POST') {
  let d: FormData;
  try {
    d = await Astro.request.formData();
  } catch {
    return new Response('Requisicao invalida.', { status: 400 });
  }
  form = {
    nome: String(d.get('nome') ?? '').trim(),
    quantidade: String(d.get('quantidade') ?? ''),
    modelo: String(d.get('modelo') ?? 'CLASSICA'),
    observacoes: String(d.get('observacoes') ?? '').trim(),
  };

  const r = await Astro.locals.api<Lote>('/api/admin/lotes', {
    metodo: 'POST',
    corpo: {
      nome: form.nome,
      quantidade: Number(form.quantidade) || 0,
      modelo: form.modelo,
      observacoes: form.observacoes || null,
    },
  });
  if (r.status === 401) return Astro.redirect('/entrar?next=%2Fadmin');
  // Vai direto para o lote novo: é lá que estão os códigos, que é o motivo de
  // ter criado o lote.
  if (r.ok && r.dados) return verDepois(`/admin/lotes/${r.dados.id}?novo=1`);
  erro = r.erro;
  campos = r.campos;
}

const [rl, rm] = await Promise.all([
  Astro.locals.api<Lote[]>('/api/admin/lotes'),
  Astro.locals.api<Metricas>('/api/admin/metricas'),
]);

const lotes = (rl.dados ?? []).slice().sort((a, b) => b.id - a.id);
const m = rm.dados;
const pendentes = lotes.filter((l) => l.status !== 'CONFIRMADO');
---

<Admin titulo="Lotes" aba="lotes">
  <h1>Lotes de tags</h1>
  <p class="sub">
    Cada lote gera os códigos das tags. O endereço que vai gravado no NFC sai
    daqui.
  </p>

  {erro && <p class="aviso" role="alert"><span>{erro}</span></p>}

  {m && (
    <dl class="metricas">
      <div class="metrica"><dt>Tags produzidas</dt><dd>{m.tagsProduzidas}</dd></div>
      <div class="metrica"><dt>Enviadas</dt><dd>{m.tagsEnviadas}</dd></div>
      <div class="metrica"><dt>Ativadas</dt><dd>{m.tagsAtivadas}</dd></div>
      <div class="metrica">
        <dt>Taxa de ativação</dt>
        <dd>{m.taxaAtivacao}%</dd>
        {/* A base sao as tags ENVIADAS, nao as produzidas: tag na caixa nao teve
            chance de ser ativada. Sem a fracao ao lado, o numero sozinho nao diz
            de que universo ele saiu. */}
        <p class="item__quando" style="margin:2px 0 0">{m.tagsAtivadas} de {m.tagsEnviadas} enviadas</p>
      </div>
      <div class="metrica"><dt>Leituras (30 dias)</dt><dd>{m.leiturasPeriodo}</dd></div>
      <div class="metrica"><dt>Em modo perdido</dt><dd>{m.petsEmModoPerdido}</dd></div>
    </dl>
  )}

  {m && m.tagsAtivadas > m.tagsEnviadas && (
    <p class="aviso" role="status">
      <span>
        <strong>Há mais tags ativadas do que marcadas como enviadas.</strong><br />
        A taxa de ativação passa de 100% porque a base são as enviadas. Marque
        as tags em <a class="link" href="/admin/tags?status=CRIADA">Tags</a> ao
        despachar, senão a métrica não serve para nada.
      </span>
    </p>
  )}

  {pendentes.length > 0 && (
    <p class="aviso" role="status">
      <span>
        <strong>{pendentes.length === 1 ? 'Um lote ainda tem os códigos de ativação em claro.' : `${pendentes.length} lotes ainda têm os códigos de ativação em claro.`}</strong><br />
        Grave os NFCs, imprima os cartões e confirme o lote. Depois de confirmado
        só resta o hash, e o cartão perdido não tem como ser reemitido.
      </span>
    </p>
  )}

  <section class="cartao">
    <h2 class="cartao__titulo">Lotes</h2>
    {lotes.length === 0 ? (
      <p class="cartao__nota" style="margin:8px 0 0">Nenhum lote ainda. Crie o primeiro abaixo.</p>
    ) : (
      <div class="tabela-rolagem">
        <table class="dados">
          <thead>
            <tr>
              <th scope="col">#</th><th scope="col">Nome</th><th scope="col">Qtd.</th>
              <th scope="col">Modelo</th><th scope="col">Situação</th><th scope="col">Produzido</th><th scope="col"></th>
            </tr>
          </thead>
          <tbody>
            {lotes.map((l) => (
              <tr>
                <td>{l.id}</td>
                <td>{l.nome}</td>
                <td>{l.quantidade}</td>
                <td>{MODELOS[l.modelo] ?? l.modelo}</td>
                <td>
                  {l.status === 'CONFIRMADO'
                    ? <span class="etiqueta etiqueta--ativa">Confirmado</span>
                    : <span class="etiqueta etiqueta--alerta">Códigos em claro</span>}
                </td>
                <td>{dia(l.produzidoEm)}</td>
                <td><a class="link" href={`/admin/lotes/${l.id}`}>Abrir</a></td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )}
  </section>

  <form class="cartao" method="POST">
    <h2 class="cartao__titulo">Novo lote</h2>
    <p class="cartao__nota">
      Gera os pares de código de cada tag: o público, que vai no NFC, e o de
      ativação, que vai impresso no cartão dentro da caixa.
    </p>

    <div class="campo">
      <label for="nome">Nome do lote</label>
      <input id="nome" name="nome" required maxlength="80" value={form.nome}
             placeholder="Primeira remessa — outubro"
             aria-invalid={campos.nome ? 'true' : undefined} />
      {campos.nome && <p class="erro-campo">{campos.nome}</p>}
    </div>

    <div class="dupla">
      <div class="campo">
        <label for="quantidade">Quantas tags</label>
        <input id="quantidade" name="quantidade" type="number" min="1" max="10000" required
               value={form.quantidade} aria-invalid={campos.quantidade ? 'true' : undefined} />
        {campos.quantidade && <p class="erro-campo">{campos.quantidade}</p>}
      </div>
      <div class="campo">
        <label for="modelo">Modelo</label>
        <select id="modelo" name="modelo" required>
          <option value="CLASSICA" selected={form.modelo === 'CLASSICA'}>Clássica</option>
          <option value="SLIM" selected={form.modelo === 'SLIM'}>Slim</option>
          <option value="COLEIRA" selected={form.modelo === 'COLEIRA'}>Coleira</option>
        </select>
      </div>
    </div>

    <div class="campo">
      <label for="observacoes">Observações</label>
      <input id="observacoes" name="observacoes" maxlength="300" value={form.observacoes}
             placeholder="Fornecedor, cor, nota fiscal…" />
    </div>

    <button class="btn btn--principal" type="submit">Gerar lote</button>
  </form>
</Admin>
