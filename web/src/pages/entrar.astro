---
export const prerender = false;

import Base from '../layouts/Base.astro';
import CampoSenha from '../components/CampoSenha.astro';
import { chamar, redirecionarCom } from '../lib/api';

const next = Astro.url.searchParams.get('next') || '/app';
const googleClientId = (typeof process !== 'undefined' ? process.env.GOOGLE_CLIENT_ID : undefined)
  ?? import.meta.env.PUBLIC_GOOGLE_CLIENT_ID
  ?? '';
let erro: string | null = null;
let email = '';
let manterConectado = false;
type RespostaGoogle = { cadastroIncompleto: boolean };

if (Astro.request.method === 'POST') {
  let dados: FormData;
  try {
    dados = await Astro.request.formData();
  } catch {
    // POST sem corpo de formulario. Responde 400 e para por aqui: redirecionar
    // para a propria URL fazia um cliente que repete o POST girar sem fim.
    return new Response('Requisicao invalida.', { status: 400 });
  }
  const credencialGoogle = String(dados.get('credencialGoogle') ?? '');
  if (credencialGoogle) {
    manterConectado = dados.get('manterConectadoGoogle') === 'true';
    const r = await chamar<RespostaGoogle>('/api/auth/google', {
      metodo: 'POST', corpo: { credencial: credencialGoogle, manterConectado }, tetoMs: 70_000,
    });
    if (r.ok) {
      const destino = r.dados?.cadastroIncompleto
        ? `/completar-cadastro?next=${encodeURIComponent(next)}`
        : next;
      return redirecionarCom(destino, r.cookies);
    }
    erro = r.status === 0 || r.status >= 500
        ? 'O login com Google está temporariamente indisponível. Tente novamente em instantes.'
        : 'Não foi possível confirmar sua conta Google. Tente novamente.';
  } else {
    email = String(dados.get('email') ?? '');
    const senha = String(dados.get('senha') ?? '');
    manterConectado = dados.has('manterConectado');

    // O Render gratuito leva cerca de um minuto para acordar. O teto geral de
    // oito segundos e correto para uma API saudavel, mas aqui fazia o primeiro
    // login falhar enquanto a requisicao ainda estava acordando o servico.
    const r = await chamar('/api/auth/login', {
      metodo: 'POST', corpo: { email, senha, manterConectado }, tetoMs: 70_000,
    });

    if (r.ok) {
      // A API emite os cookies; a pagina so repassa. O token nunca chega perto
      // de JavaScript do cliente.
      return redirecionarCom(next, r.cookies);
    }
    erro = r.status === 0 || r.status >= 500
      ? 'Nosso sistema está temporariamente indisponível. Sua senha não foi considerada incorreta. Aguarde um instante e tente novamente.'
      : r.status === 423
        ? 'Muitas tentativas seguidas. Aguarde alguns minutos e tente de novo.'
        : 'E-mail ou senha incorretos.';
  }
}
---

<Base titulo="Entrar">
  <h1>Entrar</h1>

  {Astro.url.searchParams.has('senha-trocada') && (
    <p class="sucesso" role="status">
      <span>Senha alterada. Entre com ela para continuar.</span>
    </p>
  )}
  <p class="sub">Use o e-mail e a senha da sua conta ConectaPet.</p>

  {erro && <p class="aviso" role="alert">{erro}</p>}

  {googleClientId && (
    <>
      <section class="google-acesso" aria-labelledby="google-titulo">
        <h2 id="google-titulo">Acesso rápido</h2>
        <p>Entre ou crie sua conta com o Google. No primeiro acesso, pediremos apenas seu telefone.</p>
        <div id="google-signin" data-client-id={googleClientId}></div>
        <p class="google-acesso__estado" aria-live="polite" hidden>Confirmando sua conta Google…</p>
      </section>
      <div class="separador" aria-hidden="true"><span>ou entre com e-mail</span></div>
      <form id="google-form" method="POST" hidden>
        <input type="hidden" name="credencialGoogle" value="" />
        <input type="hidden" name="manterConectadoGoogle" value="false" />
      </form>
      <script id="google-client" src="https://accounts.google.com/gsi/client" async defer></script>
    </>
  )}

  <form class="cartao" method="POST">
    <div class="campo">
      <label for="email">E-mail</label>
      <input id="email" name="email" type="email" autocomplete="email"
             inputmode="email" required value={email} />
    </div>
    <CampoSenha autocomplete="current-password" />
    <label class="manter-conectado">
      <input name="manterConectado" type="checkbox" value="true" checked={manterConectado} />
      <span>
        <strong>Manter conectado</strong>
        <small>Use somente em um dispositivo pessoal.</small>
      </span>
    </label>
    <button class="btn btn--principal" type="submit">Entrar</button>
    <p class="estado-envio" aria-live="polite" hidden>
      Conectando com segurança. O primeiro acesso pode levar até um minuto.
    </p>
  </form>

  <p class="rodape-link">
    <a class="link" href="/esqueci-senha">Esqueci minha senha</a>
  </p>
  <p class="rodape-link" style="margin-top:8px">
    Não tem conta? <a class="link" href={`/criar-conta?next=${encodeURIComponent(next)}`}>Criar agora</a>
  </p>
</Base>

<script>
  const formulario = document.querySelector<HTMLFormElement>('form.cartao');
  const botao = formulario?.querySelector<HTMLButtonElement>('button[type="submit"]');
  const estado = formulario?.querySelector<HTMLElement>('.estado-envio');
  formulario?.addEventListener('submit', () => {
    if (botao) {
      botao.disabled = true;
      botao.textContent = 'Conectando…';
    }
    if (estado) estado.hidden = false;
  });

  const destinoGoogle = document.querySelector<HTMLElement>('#google-signin');
  const scriptGoogle = document.querySelector<HTMLScriptElement>('#google-client');
  const formularioGoogle = document.querySelector<HTMLFormElement>('#google-form');
  const estadoGoogle = document.querySelector<HTMLElement>('.google-acesso__estado');

  const iniciarGoogle = () => {
    const google = (window as any).google;
    const clientId = destinoGoogle?.dataset.clientId;
    if (!google?.accounts?.id || !destinoGoogle || !clientId || !formularioGoogle) return;
    google.accounts.id.initialize({
      client_id: clientId,
      auto_select: false,
      cancel_on_tap_outside: true,
      callback: (resposta: { credential?: string }) => {
        if (!resposta.credential) return;
        const credencial = formularioGoogle.querySelector<HTMLInputElement>('[name="credencialGoogle"]');
        const persistencia = formularioGoogle.querySelector<HTMLInputElement>('[name="manterConectadoGoogle"]');
        const escolha = document.querySelector<HTMLInputElement>('[name="manterConectado"]');
        if (!credencial || !persistencia) return;
        credencial.value = resposta.credential;
        persistencia.value = escolha?.checked ? 'true' : 'false';
        if (estadoGoogle) estadoGoogle.hidden = false;
        formularioGoogle.requestSubmit();
      },
    });
    google.accounts.id.renderButton(destinoGoogle, {
      type: 'standard', theme: 'outline', size: 'large', text: 'continue_with',
      shape: 'pill', logo_alignment: 'left', width: Math.floor(destinoGoogle.clientWidth),
    });
  };

  if ((window as any).google?.accounts?.id) iniciarGoogle();
  else scriptGoogle?.addEventListener('load', iniciarGoogle, { once: true });
</script>

<style>
  .estado-envio {
    margin: 12px 0 0;
    color: var(--cinza, #263640);
    font-size: .9rem;
    line-height: 1.45;
    text-align: center;
  }
  .google-acesso {
    margin-bottom: 20px;
    padding: 18px 20px;
    border: 1px solid var(--gray-300);
    border-radius: 20px;
    background: rgba(255,255,255,.76);
    text-align: center;
  }
  .google-acesso h2 { margin: 0; color: var(--navy-900); font-size: 18px; }
  .google-acesso p { margin: 5px auto 14px; max-width: 38ch; font-size: 14px; line-height: 1.45; }
  #google-signin { width: 100%; min-height: 44px; overflow: hidden; }
  .google-acesso .google-acesso__estado { margin: 12px 0 0; font-weight: 600; color: var(--teal-700); }
  .separador { display: flex; align-items: center; gap: 12px; margin: 0 0 20px; color: var(--navy-700); font-size: 13px; }
  .separador::before,.separador::after { content: ''; height: 1px; flex: 1; background: var(--gray-300); }
  .separador span { white-space: nowrap; }
</style>
