---
export const prerender = false;

import Base from '../layouts/Base.astro';
import CampoSenha from '../components/CampoSenha.astro';
import { chamar, redirecionarCom } from '../lib/api';

const next = Astro.url.searchParams.get('next') || '/app';
let erro: string | null = null;
let email = '';
let manterConectado = false;

if (Astro.request.method === 'POST') {
  let dados: FormData;
  try {
    dados = await Astro.request.formData();
  } catch {
    // POST sem corpo de formulario. Responde 400 e para por aqui: redirecionar
    // para a propria URL fazia um cliente que repete o POST girar sem fim.
    return new Response('Requisicao invalida.', { status: 400 });
  }
  email = String(dados.get('email') ?? '');
  const senha = String(dados.get('senha') ?? '');
  manterConectado = dados.has('manterConectado');

  // O Render gratuito leva cerca de um minuto para acordar. O teto geral de
  // oito segundos e correto para uma API saudavel, mas aqui fazia o primeiro
  // login falhar enquanto a requisicao ainda estava acordando o servico.
  const r = await chamar('/api/auth/login', {
    metodo: 'POST', corpo: { email, senha, manterConectado }, tetoMs: 70_000,
  });

  if (r.ok) {
    // A API emite os cookies; a pagina so repassa. O token nunca chega perto
    // de JavaScript do cliente.
    return redirecionarCom(next, r.cookies);
  }
  erro = r.status === 0 || r.status >= 500
    ? 'Nosso sistema está temporariamente indisponível. Sua senha não foi considerada incorreta. Aguarde um instante e tente novamente.'
    : r.status === 423
      ? 'Muitas tentativas seguidas. Aguarde alguns minutos e tente de novo.'
      : 'E-mail ou senha incorretos.';
}
---

<Base titulo="Entrar">
  <h1>Entrar</h1>

  {Astro.url.searchParams.has('senha-trocada') && (
    <p class="sucesso" role="status">
      <span>Senha alterada. Entre com ela para continuar.</span>
    </p>
  )}
  <p class="sub">Use o e-mail e a senha da sua conta ConectaPet.</p>

  {erro && <p class="aviso" role="alert">{erro}</p>}

  <form class="cartao" method="POST">
    <div class="campo">
      <label for="email">E-mail</label>
      <input id="email" name="email" type="email" autocomplete="email"
             inputmode="email" required value={email} />
    </div>
    <CampoSenha autocomplete="current-password" />
    <label class="manter-conectado">
      <input name="manterConectado" type="checkbox" value="true" checked={manterConectado} />
      <span>
        <strong>Manter conectado</strong>
        <small>Use somente em um dispositivo pessoal.</small>
      </span>
    </label>
    <button class="btn btn--principal" type="submit">Entrar</button>
    <p class="estado-envio" aria-live="polite" hidden>
      Conectando com segurança. O primeiro acesso pode levar até um minuto.
    </p>
  </form>

  <p class="rodape-link">
    <a class="link" href="/esqueci-senha">Esqueci minha senha</a>
  </p>
  <p class="rodape-link" style="margin-top:8px">
    Não tem conta? <a class="link" href={`/criar-conta?next=${encodeURIComponent(next)}`}>Criar agora</a>
  </p>
</Base>

<script>
  const formulario = document.querySelector<HTMLFormElement>('form.cartao');
  const botao = formulario?.querySelector<HTMLButtonElement>('button[type="submit"]');
  const estado = formulario?.querySelector<HTMLElement>('.estado-envio');
  formulario?.addEventListener('submit', () => {
    if (botao) {
      botao.disabled = true;
      botao.textContent = 'Conectando…';
    }
    if (estado) estado.hidden = false;
  });
</script>

<style>
  .estado-envio {
    margin: 12px 0 0;
    color: var(--cinza, #263640);
    font-size: .9rem;
    line-height: 1.45;
    text-align: center;
  }
</style>
