---
export const prerender = false;

import Base from '../../layouts/Base.astro';
import { normalizarCodigo, caractereInvalido, verDepois } from '../../lib/api';

const sessao = await Astro.locals.api<{ nome: string }>('/api/me');
if (!sessao.ok) return Astro.redirect('/ativar');

const guardado = normalizarCodigo(Astro.cookies.get('cp_ativando')?.value);

let erro: string | null = null;
let dica: string | null = null;
let codigoPublico = guardado;

/**
 * Assume a tag para quem está logado.
 *
 * Chamada de dois lugares: automaticamente, quando o código já veio da URL da
 * tag e a pessoa acabou de criar a conta; e pelo formulário abaixo, quando ela
 * chegou aqui sem código e digitou o dele.
 */
async function reivindicar(codigo: string) {
  const r = await Astro.locals.api('/api/tags/reivindicar', {
    metodo: 'POST',
    corpo: { codigoPublico: codigo },
  });

  if (r.ok) {
    Astro.cookies.set('cp_ativando', codigo, {
      path: '/', httpOnly: true, sameSite: 'lax', maxAge: 60 * 60 * 24 * 7,
    });
    return verDepois('/ativar/pet');
  }

  // Cada estado pede uma ação diferente de quem está do outro lado.
  if (r.status === 409) {
    erro = 'Esta tag já tem dono.';
    dica = 'Se você a recebeu de outra pessoa, peça a ela um código de transferência — é assim que a tag muda de titular.';
  } else if (r.status === 423) {
    erro = 'Muitas tentativas seguidas.';
    dica = 'Por segurança, aguarde uma hora antes de tentar de novo.';
  } else if (r.status === 400 || r.status === 404) {
    erro = 'Não encontrei esta tag.';
    dica = 'Confira o código impresso nela. São 10 caracteres.';
  } else {
    erro = r.erro;
  }
  return null;
}

if (Astro.request.method === 'POST') {
  let d: FormData;
  try {
    d = await Astro.request.formData();
  } catch {
    return new Response('Requisicao invalida.', { status: 400 });
  }
  codigoPublico = normalizarCodigo(String(d.get('codigoPublico') ?? ''));

  const ruim = caractereInvalido(codigoPublico);
  if (ruim) {
    // Orienta, não adivinha. Trocar 0 por O automaticamente esconderia o
    // engano e faria a pessoa errar de novo sem entender por quê.
    const parecidos: Record<string, string> = {
      '0': 'O', 'O': '0', '1': 'I ou L', 'I': '1', 'L': '1', 'U': 'V',
    };
    erro = `O caractere "${ruim}" não existe nos nossos códigos.`;
    dica = parecidos[ruim]
      ? `Confira na tag: pode ser um "${parecidos[ruim]}". Nossos códigos nunca usam 0, O, I, 1, L nem U.`
      : 'Nossos códigos usam apenas números de 2 a 9 e letras, sem 0, O, I, 1, L nem U.';
  } else if (codigoPublico.length !== 10) {
    erro = 'O código da tag tem 10 caracteres.';
  } else {
    const resposta = await reivindicar(codigoPublico);
    if (resposta) return resposta;
  }
} else if (guardado && !caractereInvalido(guardado) && guardado.length === 10) {
  // O código já veio da tag: não há o que perguntar. Assume e segue.
  const resposta = await reivindicar(guardado);
  if (resposta) return resposta;
}
---

<Base titulo="Ativar minha tag" passo={{ atual: 2, total: 3 }}>
  <h1>Qual é o código da sua tag?</h1>
  <p class="sub">
    São 10 caracteres, gravados na própria tag. Se você chegou aqui encostando
    o celular nela, o código já vem preenchido.
  </p>

  {erro && (
    <p class="aviso" role="alert">
      <span><strong>{erro}</strong>{dica && <><br />{dica}</>}</span>
    </p>
  )}

  <form class="cartao" method="POST">
    <div class="campo">
      <label for="codigoPublico">Código da tag</label>
      <input id="codigoPublico" name="codigoPublico" class="mono" required
             maxlength="10" minlength="10" autocapitalize="characters"
             autocomplete="off" spellcheck="false" value={codigoPublico}
             placeholder="10 caracteres" autofocus />
      <p class="ajuda">Sem 0, O, I, 1, L nem U — esses nunca aparecem nos nossos códigos.</p>
    </div>

    <button class="btn btn--principal" type="submit">Ativar minha tag</button>
  </form>

  <p class="rodape-link">
    Recebeu a tag de outra pessoa? <a class="link" href="/app/receber">Use um código de transferência</a>
  </p>
</Base>

<style>
  .mono { font-family:ui-monospace,SFMono-Regular,Menlo,monospace; letter-spacing:.14em; text-transform:uppercase; }
</style>

<script>
  // Conveniência: caixa alta e sem espaços enquanto digita. A validação de
  // verdade é a do servidor — isto aqui só evita atrito.
  const campo = document.getElementById('codigoPublico') as HTMLInputElement | null;
  campo?.addEventListener('input', () => {
    const posicao = campo.selectionStart;
    campo.value = campo.value.toUpperCase().replace(/[\s-]/g, '');
    campo.setSelectionRange(posicao, posicao);
  });
</script>
