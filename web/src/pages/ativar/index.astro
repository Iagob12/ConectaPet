---
// Entrada do fluxo de ativacao.
//
// O codigo publico chega pela URL (a pessoa veio de /p/{codigo}) e e guardado
// num cookie de servidor. Nao uso sessionStorage: ele e por aba, e o link de
// verificacao de e-mail abre numa aba nova — contexto novo, storage vazio.
// Seria exatamente o cenario que precisamos cobrir.
export const prerender = false;

import Base from '../../layouts/Base.astro';
import { chamar, normalizarCodigo, caractereInvalido } from '../../lib/api';

const codigoUrl = normalizarCodigo(Astro.url.searchParams.get('codigo'));
const codigoCookie = normalizarCodigo(Astro.cookies.get('cp_ativando')?.value);
const codigo = codigoUrl || codigoCookie;

if (codigo && !caractereInvalido(codigo)) {
  // Sobrevive a sair da URL e voltar.
  Astro.cookies.set('cp_ativando', codigo, {
    path: '/', httpOnly: true, sameSite: 'lax', maxAge: 60 * 60 * 24 * 7,
  });
}

// Consulta leve antes de mandar a pessoa criar conta. O endpoint so distingue
// ATIVO de NAO_ATIVADA — nao diz se a tag existe — mas isso basta para o caso
// que da errado na pratica: quem encosta o celular na tag de outra pessoa e
// tenta ativar. Sem o aviso, ela cria uma conta e so descobre no passo 3, ja
// tendo gasto uma das cinco tentativas por hora.
const status = codigo && !caractereInvalido(codigo)
  ? await chamar<{ estado: string }>(`/api/public/tags/${codigo}/status`)
  : null;
const jaEmUso = status?.dados?.estado === 'ATIVO';

const sessao = await Astro.locals.api<{ nome: string }>('/api/me');

// Ja logado: pula direto para o codigo de ativacao. Se a tag ja esta em uso,
// fica aqui para explicar em vez de deixar a pessoa errar no passo seguinte.
if (sessao.ok && !jaEmUso) return Astro.redirect('/ativar/codigo');

const proximo = encodeURIComponent('/ativar/codigo');
---

<Base titulo="Ativar minha tag" passo={{ atual: 1, total: 4 }}>
  <h1>Vamos ativar sua tag</h1>
  <p class="sub">
    Em poucos passos o perfil do seu pet fica pronto. Primeiro, crie sua conta
    ou entre, se já tiver uma.
  </p>

  {jaEmUso ? (
    <>
      <p class="aviso" role="status">
        <span>
          <strong>Esta tag já está em uso.</strong><br />
          Ela pertence a alguém e já mostra o perfil de um pet.
        </span>
      </p>
      <div class="cartao">
        <p style="margin-top:0">
          Se você recebeu este pet de outra pessoa, peça a ela um
          <strong> código de transferência</strong> — é assim que a tag muda de
          titular, sem passar pelo código de ativação.
        </p>
        <a class="btn btn--principal" href="/app/receber">Tenho um código de transferência</a>
        <a class="btn btn--secundario" href={`/p/${codigo}`}>Ver a página desta tag</a>
      </div>
    </>
  ) : (
    <>
      {codigo && (
        <p class="aviso aviso--calmo">
          <span>Guardamos a tag <strong>{codigo}</strong>. Ela continua aqui mesmo que você saia e volte.</span>
        </p>
      )}

      <div class="cartao">
        <a class="btn btn--principal" href={`/criar-conta?next=${proximo}`}>Criar minha conta</a>
        <a class="btn btn--secundario" href={`/entrar?next=${proximo}`}>Já tenho conta</a>
      </div>
    </>
  )}

  <p class="rodape-link">
    Ainda não recebeu sua tag? <a class="link" href="/">Conheça a ConectaPet</a>
  </p>
</Base>
