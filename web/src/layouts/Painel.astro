---
interface Props {
  titulo: string;
  /** Quando presente, vira o link "voltar" no topo do conteudo. */
  voltar?: { href: string; texto: string };
  aba?: 'pets' | 'conta';
  /** Telas de visão geral aproveitam o desktop; formulários continuam focados. */
  largura?: 'normal' | 'larga';
  classe?: string;
}
const { titulo, voltar, aba, largura = 'normal', classe = '' } = Astro.props;

import '../styles/base.css';
---

<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <!-- Painel e dado pessoal: nao entra em indice de busca. -->
  <meta name="robots" content="noindex, nofollow" />
  <meta name="theme-color" content="#FCEBD2" />
  <meta name="color-scheme" content="light" />
  <title>{titulo} — ConectaPet</title>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
</head>
<body>
<a class="pular-conteudo" href="#conteudo">Pular para o conteúdo</a>
<div class="moldura">
<div class="folha-papel">
  <header class="barra topo">
    <a class="marca" href="/" aria-label="ConectaPet — ir para a página inicial">
      <img src="/marca.png" srcset="/marca.png 1x, /marca@2x.png 2x"
           width="52" height="48" alt="" decoding="async" />
      <span class="marca__texto">
        <span class="marca__nome">Conecta<span>Pet</span></span>
        <span class="marca__slogan">Aproxima e Protege</span>
      </span>
    </a>
    <nav class="barra__menu" aria-label="Painel">
      <a href="/app" aria-current={aba === 'pets' ? 'page' : undefined}>Meus pets</a>
      <a href="/app/conta" aria-current={aba === 'conta' ? 'page' : undefined}>Conta</a>
      <a href="/sair">Sair</a>
    </nav>
  </header>
  <main class:list={['folha', largura === 'larga' && 'folha--painel-largo', classe]} id="conteudo" tabindex="-1">
    {voltar && <a class="voltar" href={voltar.href}>&larr; {voltar.texto}</a>}
    <slot />
  </main>
</div>
</div>
</body>
</html>
