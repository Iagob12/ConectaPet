---
interface Props {
  titulo: string;
  /** Quando presente, vira o link "voltar" no topo do conteudo. */
  voltar?: { href: string; texto: string };
  aba?: 'pets' | 'conta';
}
const { titulo, voltar, aba } = Astro.props;

import '../styles/base.css';
---

<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <!-- Painel e dado pessoal: nao entra em indice de busca. -->
  <meta name="robots" content="noindex, nofollow" />
  <title>{titulo} — ConectaPet</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <!-- As mesmas famílias da vitrine. display=swap: o texto aparece na hora com
       a fonte do sistema e troca quando a real chega, em vez de segurar a tela. -->
  <link rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Poppins:wght@700;800&display=swap" />
  <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
</head>
<body>
<div class="moldura">
<div class="folha-papel">
  <header class="barra">
    <a class="barra__marca" href="/app">
      <img class="marca-chip" src="/marca-branca.png" srcset="/marca-branca.png 1x, /marca-branca@2x.png 2x"
      width="46" height="42" alt="" />
      <span>ConectaPet</span>
    </a>
    <nav class="barra__menu" aria-label="Painel">
      <a href="/app" aria-current={aba === 'pets' ? 'page' : undefined}>Meus pets</a>
      <a href="/app/conta" aria-current={aba === 'conta' ? 'page' : undefined}>Conta</a>
      <a href="/sair">Sair</a>
    </nav>
  </header>
  <main class="folha">
    {voltar && <a class="voltar" href={voltar.href}>&larr; {voltar.texto}</a>}
    <slot />
  </main>
  <!-- As ondas do símbolo, fechando a folha. Decoração pura: aria-hidden. -->
  <div class="ondas" aria-hidden="true">
    <svg viewBox="0 62 200 88" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" focusable="false">
      <path d="M38.2 66.8A70 70 0 0 0 161.8 66.8"/>
      <path d="M25.8 73.4A84 84 0 0 0 174.2 73.4"/>
      <path d="M13.5 80A98 98 0 0 0 186.5 80"/>
      <path d="M1.2 86.6A112 112 0 0 0 198.8 86.6"/>
    </svg>
  </div>
</div>
</div>
</body>
</html>
