---
interface Props {
  titulo: string;
  voltar?: { href: string; texto: string };
  aba?: 'lotes' | 'tags';
}
const { titulo, voltar, aba } = Astro.props;

import '../styles/base.css';
---

<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>{titulo} — Administrativo ConectaPet</title>
  <style>
    /* A barra do administrativo e escura de proposito: e para ficar obvio, de
       relance, que a tela aberta nao e a do tutor. */
    .barra--admin{background:var(--navy-900)}
  </style>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <!-- As mesmas famílias da vitrine. display=swap: o texto aparece na hora com
       a fonte do sistema e troca quando a real chega, em vez de segurar a tela. -->
  <link rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Poppins:wght@700;800&display=swap" />
  <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
</head>
<body>
  <header class="barra barra--admin">
    <a class="barra__marca" href="/admin">
      <img class="marca-chip" src="/marca.png" srcset="/marca.png 1x, /marca@2x.png 2x"
      width="46" height="42" alt="" />
      <span>ConectaPet · admin</span>
    </a>
    <nav class="barra__menu" aria-label="Administrativo">
      <a href="/admin" aria-current={aba === 'lotes' ? 'page' : undefined}>Lotes</a>
      <a href="/admin/tags" aria-current={aba === 'tags' ? 'page' : undefined}>Tags</a>
      <a href="/sair">Sair</a>
    </nav>
  </header>
  <main class="folha folha--larga">
    {voltar && <a class="voltar" href={voltar.href}>&larr; {voltar.texto}</a>}
    <slot />
  </main>
</body>
</html>
