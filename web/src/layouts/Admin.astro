---
interface Props {
  titulo: string;
  voltar?: { href: string; texto: string };
  aba?: 'lotes' | 'tags' | 'usuarios' | 'emails';
}
const { titulo, voltar, aba } = Astro.props;

import '../styles/base.css';
---

<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <meta name="theme-color" content="#22313A" />
  <meta name="color-scheme" content="light" />
  <title>{titulo} — Administrativo ConectaPet</title>
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
</head>
<body>
<a class="pular-conteudo" href="#conteudo">Pular para o conteúdo</a>
<div class="moldura">
<div class="folha-papel">
  <header class="barra topo topo--admin">
    <a class="marca" href="/" aria-label="ConectaPet — ir para a página inicial">
      <img src="/marca-branca.png" srcset="/marca-branca.png 1x, /marca-branca@2x.png 2x"
           width="52" height="48" alt="" decoding="async" />
      <span class="marca__texto">
        <span class="marca__nome">Conecta<span>Pet</span> · admin</span>
        <span class="marca__slogan">Aproxima e Protege</span>
      </span>
    </a>
    <nav class="barra__menu" aria-label="Administrativo">
      <a href="/admin" aria-current={aba === 'lotes' ? 'page' : undefined}>Lotes</a>
      <a href="/admin/tags" aria-current={aba === 'tags' ? 'page' : undefined}>Tags</a>
      <a href="/admin/usuarios" aria-current={aba === 'usuarios' ? 'page' : undefined}>Contas</a>
      <a href="/admin/emails" aria-current={aba === 'emails' ? 'page' : undefined}>E-mails</a>
      <a href="/sair">Sair</a>
    </nav>
  </header>
  <main class="folha folha--larga" id="conteudo" tabindex="-1">
    {voltar && <a class="voltar" href={voltar.href}>&larr; {voltar.texto}</a>}
    <slot />
  </main>
</div>
</div>
</body>
</html>
