---
interface Props {
  titulo: string;
  descricao?: string;
  /** Toda tela de conta e ativação leva noindex: são páginas de dados pessoais. */
  passo?: { atual: number; total: number };
  /** Páginas institucionais públicas podem ser indexadas. */
  indexavel?: boolean;
}
const {
  titulo,
  descricao = 'ConectaPet: identificação NFC para pets, com contato rápido e seguro com o tutor.',
  passo,
  indexavel = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, 'https://www.conectapet.app.br').href;

import '../styles/base.css';
---

<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content={indexavel ? 'index, follow' : 'noindex, nofollow'} />
  <meta name="description" content={descricao} />
  <meta name="theme-color" content="#FCEBD2" />
  <meta name="color-scheme" content="light" />
  <title>{titulo} — ConectaPet</title>
  {indexavel && <link rel="canonical" href={canonical} />}
  {indexavel && <meta property="og:type" content="website" />}
  {indexavel && <meta property="og:locale" content="pt_BR" />}
  {indexavel && <meta property="og:site_name" content="ConectaPet" />}
  {indexavel && <meta property="og:title" content={`${titulo} — ConectaPet`} />}
  {indexavel && <meta property="og:description" content={descricao} />}
  {indexavel && <meta property="og:url" content={canonical} />}
  
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
</head>
<body>
<a class="pular-conteudo" href="#conteudo">Pular para o conteúdo</a>
<div class="moldura">
<div class="folha-papel">
  <header class="topo">
    <a class="marca" href="/" aria-label="ConectaPet — ir para a página inicial">
      <img src="/marca.png" srcset="/marca.png 1x, /marca@2x.png 2x"
           width="52" height="48" alt="" decoding="async" />
      <span class="marca__texto">
        <span class="marca__nome">Conecta<span>Pet</span></span>
        <span class="marca__slogan">Aproxima e Protege</span>
      </span>
    </a>
  </header>
  <main class="folha" id="conteudo" tabindex="-1">
    {passo && (
      <div class="passos" role="progressbar" aria-valuenow={passo.atual}
           aria-valuemin="1" aria-valuemax={passo.total}
           aria-label={`Passo ${passo.atual} de ${passo.total}`}>
        {Array.from({ length: passo.total }).map((_, i) => (
          <i class={i < passo.atual ? 'feito' : ''}></i>
        ))}
      </div>
    )}
    <slot />
  </main>
</div>
</div>
</body>
</html>
