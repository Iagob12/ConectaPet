---
interface Props {
  titulo: string;
  /** Toda tela de conta e ativação leva noindex: são páginas de dados pessoais. */
  passo?: { atual: number; total: number };
  /** Páginas institucionais públicas podem ser indexadas. */
  indexavel?: boolean;
}
const { titulo, passo, indexavel = false } = Astro.props;

import '../styles/base.css';
---

<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content={indexavel ? 'index, follow' : 'noindex, nofollow'} />
  <meta name="theme-color" content="#FCEBD2" />
  <meta name="color-scheme" content="light" />
  <title>{titulo} — ConectaPet</title>
  
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <!-- As mesmas famílias da vitrine. display=swap: o texto aparece na hora com
       a fonte do sistema e troca quando a real chega, em vez de segurar a tela. -->
  <link rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Poppins:wght@700;800&display=swap" />
  <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
</head>
<body>
<a class="pular-conteudo" href="#conteudo">Pular para o conteúdo</a>
<div class="moldura">
<div class="folha-papel">
  <header class="topo">
    <a class="marca" href="/" aria-label="ConectaPet — ir para a página inicial">
      <img src="/marca.png" srcset="/marca.png 1x, /marca@2x.png 2x"
           width="52" height="48" alt="" decoding="async" />
      <span class="marca__texto">
        <span class="marca__nome">Conecta<span>Pet</span></span>
        <span class="marca__slogan">Aproxima e Protege</span>
      </span>
    </a>
  </header>
  <main class="folha" id="conteudo" tabindex="-1">
    {passo && (
      <div class="passos" role="progressbar" aria-valuenow={passo.atual}
           aria-valuemin="1" aria-valuemax={passo.total}
           aria-label={`Passo ${passo.atual} de ${passo.total}`}>
        {Array.from({ length: passo.total }).map((_, i) => (
          <i class={i < passo.atual ? 'feito' : ''}></i>
        ))}
      </div>
    )}
    <slot />
  </main>
</div>
</div>
</body>
</html>
