---
interface Props {
  titulo: string;
  /** Toda tela de conta e ativação leva noindex: são páginas de dados pessoais. */
  passo?: { atual: number; total: number };
}
const { titulo, passo } = Astro.props;

import '../styles/base.css';
---

<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="noindex, nofollow" />
  <title>{titulo} — ConectaPet</title>
  
  <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
</head>
<body>
  <p class="topo">
    <img class="marca-chip" src="/marca.png" srcset="/marca.png 1x, /marca@2x.png 2x"
    width="46" height="42" alt="" />
    <span>ConectaPet</span>
  </p>
  <main class="folha">
    {passo && (
      <div class="passos" role="progressbar" aria-valuenow={passo.atual}
           aria-valuemin="1" aria-valuemax={passo.total}
           aria-label={`Passo ${passo.atual} de ${passo.total}`}>
        {Array.from({ length: passo.total }).map((_, i) => (
          <i class={i < passo.atual ? 'feito' : ''}></i>
        ))}
      </div>
    )}
    <slot />
  </main>
</body>
</html>
