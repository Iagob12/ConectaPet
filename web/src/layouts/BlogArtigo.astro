---
import ConteudoPublico from './ConteudoPublico.astro';

interface Props {
  titulo: string;
  descricao: string;
  slug: string;
  categoria: string;
  tempoLeitura: string;
  imagem: string;
  imagemAlt: string;
}

const { titulo, descricao, slug, categoria, tempoLeitura, imagem, imagemAlt } = Astro.props;
const origem = 'https://www.conectapet.app.br';
const caminho = `/blog/${slug}`;
const canonical = `${origem}${caminho}`;
const todosArtigos = [
  { slug: 'achei-um-cachorro-perdido-o-que-fazer', titulo: 'Achei um cachorro perdido: o que fazer?', categoria: 'Pet encontrado' },
  { slug: 'tag-nfc-plaquinha-microchip-ou-gps', titulo: 'Tag NFC, plaquinha, microchip ou GPS?', categoria: 'Identificação pet' },
  { slug: 'como-evitar-que-seu-cachorro-se-perca', titulo: 'Como evitar que seu cachorro se perca', categoria: 'Prevenção' },
];
const relacionados = todosArtigos.filter((artigo) => artigo.slug !== slug);
const schemaArtigo = {
  '@type': 'BlogPosting',
  '@id': `${canonical}#artigo`,
  headline: titulo,
  description: descricao,
  datePublished: '2026-09-11',
  dateModified: '2026-09-11',
  inLanguage: 'pt-BR',
  mainEntityOfPage: { '@id': `${canonical}#pagina` },
  image: `${origem}${imagem}`,
  author: { '@type': 'Organization', name: 'Equipe ConectaPet', url: `${origem}/sobre-a-conectapet` },
  publisher: { '@id': `${origem}/#organizacao` },
};
---

<ConteudoPublico
  titulo={titulo}
  descricao={descricao}
  caminho={caminho}
  rotulo={categoria}
  imagem={imagem}
  schemaAdicional={schemaArtigo}
>
  <article class="blog-artigo">
    <header class="blog-artigo__cabecalho">
      <a class="blog-artigo__voltar" href="/blog">← Todos os artigos</a>
      <p class="seo-hero__rotulo">{categoria}</p>
      <h1>{titulo}</h1>
      <p class="blog-artigo__resumo">{descricao}</p>
      <div class="blog-artigo__meta">
        <span>Equipe ConectaPet</span>
        <time datetime="2026-09-11">11 de setembro de 2026</time>
        <span>{tempoLeitura}</span>
      </div>
    </header>

    <img class="blog-artigo__capa" src={imagem} alt={imagemAlt} width="1000" height="750" />

    <div class="blog-artigo__grade">
      <div class="blog-artigo__corpo"><slot /></div>
      <aside class="blog-artigo__lateral">
        <strong>Proteção começa pela identificação</strong>
        <p>A tag ConectaPet ajuda quem encontrou seu pet a falar diretamente com você.</p>
        <a class="seo-btn" href="/chaveiro-nfc-pet">Conhecer o chaveiro NFC</a>
      </aside>
    </div>

    <section class="blog-artigo__relacionados" aria-labelledby="continue-lendo">
      <div><p>Mais orientações</p><h2 id="continue-lendo">Continue lendo</h2></div>
      <div class="blog-artigo__relacionados-grid">
        {relacionados.map((artigo) => (
          <a href={`/blog/${artigo.slug}`}><span>{artigo.categoria}</span><strong>{artigo.titulo}</strong><b aria-hidden="true">→</b></a>
        ))}
      </div>
    </section>
  </article>
</ConteudoPublico>

<style is:global>
  .blog-artigo{max-width:900px;margin:0 auto}
  .blog-artigo__cabecalho{max-width:760px;margin:0 auto 34px;text-align:center}
  .blog-artigo__voltar{display:block;width:max-content;margin:0 auto 28px;color:var(--teal-700);font-weight:700}
  .blog-artigo__cabecalho h1{margin:0 auto 18px;color:var(--navy-900);font-size:clamp(32px,5vw,52px);line-height:1.1;letter-spacing:-.025em}
  .blog-artigo__resumo{margin:0 auto;max-width:68ch;font-size:clamp(17px,2vw,20px);line-height:1.6}
  .blog-artigo__meta{display:flex;flex-wrap:wrap;justify-content:center;gap:8px 18px;margin-top:20px;color:var(--navy-700);font-size:14px}
  .blog-artigo__meta>*+*::before{content:'•';margin-right:18px;color:var(--teal-600)}
  .blog-artigo__capa{display:block;width:100%;max-height:520px;object-fit:cover;border:2px solid var(--navy-900);border-radius:var(--radius-xl);box-shadow:var(--shadow-hard)}
  .blog-artigo__grade{display:grid;grid-template-columns:minmax(0,1fr) 250px;gap:48px;align-items:start;margin-top:48px}
  .blog-artigo__corpo{min-width:0}
  .blog-artigo__corpo h2{margin:44px 0 14px;color:var(--navy-900);font-size:clamp(24px,3vw,31px);line-height:1.2}
  .blog-artigo__corpo h2:first-child{margin-top:0}
  .blog-artigo__corpo h3{margin:28px 0 8px;color:var(--navy-900);font-size:20px}
  .blog-artigo__corpo p,.blog-artigo__corpo li{font-size:17px;line-height:1.75}
  .blog-artigo__corpo li+li{margin-top:8px}
  .blog-artigo__corpo a{color:var(--teal-700);font-weight:700}
  .blog-artigo__destaque{margin:28px 0;padding:20px 22px;border-left:5px solid var(--orange-500);border-radius:var(--radius-md);background:var(--orange-100)}
  .blog-artigo__destaque p{margin:0}
  .blog-artigo__lateral{position:sticky;top:100px;padding:22px;border:2px solid var(--navy-900);border-radius:var(--radius-lg);background:var(--teal-100);box-shadow:3px 3px 0 var(--navy-900)}
  .blog-artigo__lateral strong{display:block;color:var(--navy-900);font:700 19px/1.3 var(--font-title)}
  .blog-artigo__lateral p{font-size:15px;line-height:1.55}
  .blog-artigo__lateral .seo-btn{width:100%;padding-inline:14px;text-align:center}
  .blog-artigo__relacionados{margin-top:64px;padding-top:34px;border-top:1px solid var(--gray-300)}
  .blog-artigo__relacionados>div:first-child p{margin:0;color:var(--teal-700);font-size:12px;font-weight:800;letter-spacing:.08em;text-transform:uppercase}
  .blog-artigo__relacionados h2{margin:4px 0 20px;color:var(--navy-900);font-size:28px}
  .blog-artigo__relacionados-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}
  .blog-artigo__relacionados-grid a{display:grid;grid-template-columns:1fr auto;gap:7px 14px;padding:20px;border:2px solid var(--navy-900);border-radius:var(--radius-lg);background:#fff;color:var(--navy-900);text-decoration:none;box-shadow:2px 2px 0 var(--navy-900)}
  .blog-artigo__relacionados-grid span{grid-column:1/-1;color:var(--teal-700);font-size:11px;font-weight:800;letter-spacing:.06em;text-transform:uppercase}
  .blog-artigo__relacionados-grid strong{font:700 17px/1.35 var(--font-title)}
  .blog-artigo__relacionados-grid b{align-self:end;color:var(--teal-700);font-size:22px}
  .blog-artigo__relacionados-grid a:hover{background:var(--teal-100)}
  @media(max-width:760px){.blog-artigo__grade{grid-template-columns:1fr;gap:36px}.blog-artigo__lateral{position:static}.blog-artigo__meta>*+*::before{display:none}.blog-artigo__meta{gap:6px 14px}.blog-artigo__capa{border-radius:var(--radius-lg)}}
  @media(max-width:560px){.blog-artigo__relacionados-grid{grid-template-columns:1fr}}
</style>
