---
import '../styles/base.css';

interface Props {
  titulo: string;
  descricao: string;
  caminho: string;
  rotulo: string;
  imagem?: string;
}

const { titulo, descricao, caminho, rotulo, imagem = '/imagens/home-resgate-conectapet.webp' } = Astro.props;
const origem = 'https://www.conectapet.app.br';
const canonical = new URL(caminho, origem).href;
const imagemAbsoluta = new URL(imagem, origem).href;
const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebPage',
      '@id': `${canonical}#pagina`,
      url: canonical,
      name: titulo,
      description: descricao,
      inLanguage: 'pt-BR',
      isPartOf: { '@id': `${origem}/#site` },
      primaryImageOfPage: { '@type': 'ImageObject', url: imagemAbsoluta },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Início', item: `${origem}/` },
        { '@type': 'ListItem', position: 2, name: titulo, item: canonical },
      ],
    },
  ],
};
---

<!doctype html>
<html lang="pt-BR">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="robots" content="index, follow, max-image-preview:large" />
  <meta name="description" content={descricao} />
  <meta name="theme-color" content="#FCEBD2" />
  <title>{titulo} — ConectaPet</title>
  <link rel="canonical" href={canonical} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Poppins:wght@700;800&display=swap" />
  <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <meta property="og:type" content="article" />
  <meta property="og:locale" content="pt_BR" />
  <meta property="og:site_name" content="ConectaPet" />
  <meta property="og:title" content={`${titulo} — ConectaPet`} />
  <meta property="og:description" content={descricao} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={imagemAbsoluta} />
  <meta name="twitter:card" content="summary_large_image" />
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
</head>
<body>
  <a class="pular-conteudo" href="#conteudo">Pular para o conteúdo</a>
  <div class="publica">
    <header class="publica__topo">
      <a class="marca" href="/" aria-label="ConectaPet — página inicial">
        <img src="/marca.png" srcset="/marca.png 1x, /marca@2x.png 2x" width="52" height="48" alt="" />
        <span class="marca__texto">
          <span class="marca__nome">Conecta<span>Pet</span></span>
          <span class="marca__slogan">Aproxima e Protege</span>
        </span>
      </a>
      <nav aria-label="Navegação principal">
        <a href="/como-configurar-tag-nfc-pet">Configurar tag</a>
        <a href="/tag-nfc-para-cachorro">Como funciona</a>
        <a href="/identificacao-petshop">Para parceiros</a>
      </nav>
      <a class="publica__acao" href="/#chamada-final">Quero minha tag</a>
    </header>

    <main id="conteudo" class="publica__conteudo" tabindex="-1">
      <div class="publica__breadcrumb"><a href="/">Início</a><span aria-hidden="true">/</span><span>{rotulo}</span></div>
      <slot />
    </main>

    <footer class="publica__rodape">
      <strong>ConectaPet</strong>
      <span>Identificação que aproxima e protege.</span>
      <a href="/privacidade">Política de privacidade</a>
    </footer>
  </div>
</body>
</html>

<style is:global>
  .publica{min-height:100vh;background:var(--sand-100);color:var(--navy-700)}
  .publica__topo{position:sticky;top:0;z-index:20;display:flex;align-items:center;gap:24px;min-height:76px;padding:10px max(20px,calc((100vw - 1200px)/2));background:rgba(255,255,255,.96);border-bottom:1px solid var(--gray-300);backdrop-filter:blur(10px)}
  .publica__topo nav{display:flex;gap:6px;margin-left:auto}
  .publica__topo nav a{padding:10px 12px;border-radius:999px;color:var(--navy-900);font-weight:600;text-decoration:none}
  .publica__topo nav a:hover{background:var(--teal-100)}
  .publica__acao{display:inline-flex;align-items:center;justify-content:center;min-height:44px;padding:8px 20px;border:2px solid var(--navy-900);border-radius:999px;background:var(--teal-500);color:var(--navy-900);font-weight:700;text-decoration:none;box-shadow:2px 2px 0 var(--navy-900)}
  .publica__conteudo{width:min(100% - 40px,1040px);margin:0 auto;padding:40px 0 80px}
  .publica__breadcrumb{display:flex;flex-wrap:wrap;gap:8px;margin-bottom:28px;font-size:14px;color:var(--navy-700)}
  .publica__breadcrumb a{color:var(--teal-700);font-weight:700}
  .seo-hero{display:grid;grid-template-columns:minmax(0,1.05fr) minmax(320px,.95fr);gap:clamp(32px,6vw,72px);align-items:center;padding:clamp(28px,5vw,56px);border:2px solid var(--navy-900);border-radius:var(--radius-xl);background:var(--white);box-shadow:var(--shadow-hard)}
  .seo-hero__rotulo{display:inline-flex;margin:0 0 14px;padding:7px 11px;border-radius:999px;background:var(--teal-100);color:var(--teal-700);font-size:12px;font-weight:800;letter-spacing:.06em;text-transform:uppercase}
  .seo-hero h1{font-size:clamp(30px,5vw,50px);max-width:18ch;margin-bottom:18px}
  .seo-hero__lead{font-size:clamp(17px,2vw,20px);line-height:1.6;margin:0 0 24px}
  .seo-hero img{display:block;width:100%;aspect-ratio:4/3;object-fit:cover;border:2px solid var(--navy-900);border-radius:var(--radius-lg)}
  .seo-btn{display:inline-flex;align-items:center;justify-content:center;min-height:50px;padding:10px 22px;border:2px solid var(--navy-900);border-radius:999px;background:var(--teal-500);color:var(--navy-900);font-weight:700;text-decoration:none;box-shadow:3px 3px 0 var(--navy-900)}
  .seo-article{display:grid;grid-template-columns:minmax(0,1fr) 280px;gap:48px;margin-top:56px;align-items:start}
  .seo-article__body{min-width:0}
  .seo-article h2{margin:48px 0 14px;color:var(--navy-900);font-size:clamp(24px,3vw,32px);line-height:1.2}
  .seo-article h2:first-child{margin-top:0}
  .seo-article h3{margin:28px 0 8px;color:var(--navy-900);font-size:20px}
  .seo-article p,.seo-article li{font-size:17px;line-height:1.7}
  .seo-article a{color:var(--teal-700);font-weight:700}
  .seo-article__aside{position:sticky;top:100px;padding:24px;border:2px solid var(--navy-900);border-radius:var(--radius-lg);background:var(--orange-100);box-shadow:3px 3px 0 var(--navy-900)}
  .seo-article__aside strong{display:block;margin-bottom:8px;color:var(--navy-900);font:700 20px/1.3 var(--font-title)}
  .seo-article__aside p{margin:0 0 18px;font-size:15px;line-height:1.55}
  .seo-steps{display:grid;gap:22px;padding:0;list-style:none;counter-reset:passo}
  .seo-step{display:grid;grid-template-columns:180px 1fr;overflow:hidden;border:2px solid var(--navy-900);border-radius:var(--radius-lg);background:var(--white);counter-increment:passo}
  .seo-step img{width:100%;height:100%;min-height:180px;object-fit:cover;border-right:2px solid var(--navy-900)}
  .seo-step div{padding:24px}
  .seo-step div::before{content:'Passo ' counter(passo);display:block;margin-bottom:8px;color:var(--teal-700);font-size:12px;font-weight:800;letter-spacing:.08em;text-transform:uppercase}
  .seo-step h2{margin:0 0 8px;font-size:22px}
  .seo-step p{margin:0}
  .seo-faq details{padding:18px 0;border-top:1px solid var(--gray-300)}
  .seo-faq summary{cursor:pointer;color:var(--navy-900);font-weight:700}
  .seo-faq details p{margin:12px 0 0}
  .publica__rodape{display:flex;gap:18px;align-items:center;justify-content:center;flex-wrap:wrap;padding:28px 20px;background:var(--navy-900);color:#fff;font-size:14px}
  .publica__rodape a{color:#fff}
  @media(max-width:800px){
    .publica__topo nav{display:none}
    .publica__acao{margin-left:auto;font-size:14px;padding-inline:14px}
    .seo-hero,.seo-article{grid-template-columns:1fr}
    .seo-hero img{order:-1}
    .seo-article__aside{position:static}
  }
  @media(max-width:560px){
    .publica__topo{gap:10px;padding-inline:16px}
    .publica__topo .marca__slogan{display:none}
    .publica__topo .marca img{width:44px}
    .publica__topo .marca__nome{font-size:17px}
    .publica__acao{font-size:13px;padding-inline:12px}
    .publica__conteudo{width:min(100% - 28px,1040px);padding-top:24px}
    .seo-hero{padding:22px}
    .seo-step{grid-template-columns:1fr}
    .seo-step img{aspect-ratio:16/10;min-height:0;border-right:0;border-bottom:2px solid var(--navy-900)}
  }
</style>
