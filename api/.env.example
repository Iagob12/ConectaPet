# Copie para .env e preencha. Nenhum segredo entra no repositorio.

# Banco (o docker-compose local usa estes mesmos valores)
MYSQL_DATABASE=conectapet
MYSQL_USER=conectapet
MYSQL_PASSWORD=senha-local
MYSQL_ROOT_PASSWORD=raiz-local
MYSQL_PORT=3306
BANCO_URL=jdbc:mysql://localhost:3306/conectapet

# Chave de assinatura do JWT. Minimo 32 bytes.
# Gere com: openssl rand -base64 48
JWT_SEGREDO=troque-esta-chave-por-uma-gerada-com-openssl-rand-base64-48

# Pimenta do HMAC que pseudonimiza o IP de quem le a tag.
# Fica FORA do banco de proposito: com ela dentro, quem vaza o banco
# reverte os 4 bilhoes de IPv4 e desanonimiza todas as leituras.
IP_PIMENTA=troque-esta-tambem-e-nunca-versione

# URL que vai gravada na tag, usada para montar o CSV do lote
URL_PUBLICA_TAG=https://conectapet.com.br/p/

# Origens autorizadas no CORS. Nunca "*".
CORS_ORIGENS=http://localhost:4321,https://conectapet.com.br
