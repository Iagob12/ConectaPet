# Copie para .env e preencha. NUNCA versione o .env preenchido.
#
#   cp .env.producao.example .env
#
# O que tem ":?" no docker-compose.yml é obrigatório: sem ele o compose recusa
# subir, em vez de deixar a pilha de pé pela metade.

# ---- Banco -----------------------------------------------------------------
MYSQL_DATABASE=conectapet
MYSQL_USER=conectapet
# Gere: openssl rand -base64 24
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=

# ---- Segredos da aplicação -------------------------------------------------
# Não têm padrão de propósito: a API se recusa a subir sem eles, em vez de
# rodar com um segredo previsível.
# Gere: openssl rand -base64 48
JWT_SEGREDO=
# Gere: openssl rand -base64 32
# Pseudonimiza o IP de quem lê a tag. Fica FORA do banco: com ela dentro, quem
# vazar o banco reverte os 4 bilhões de IPv4 e desanonimiza todas as leituras.
IP_PIMENTA=

# ---- Endereços -------------------------------------------------------------
# Troque conectapet.com.br pelo seu domínio em TODOS os quatro.

# O que vai gravado no chip NFC. É a única linha aqui que não tem conserto por
# software: uma vez gravada e entregue, mudar o domínio quebra todas as tags
# em campo. Confira antes de gravar o primeiro lote.
URL_PUBLICA_TAG=https://conectapet.com.br/p/

# O endereço público do site. Entra nos links de e-mail e, em tempo de build,
# na lista de hosts que o site aceita — errado aqui, todo formulário dá 403.
URL_SITE=https://conectapet.com.br

# O endereço público da API, como o NAVEGADOR a alcança. O site fala com ela
# pela rede interna, mas o navegador busca a foto e confirma a leitura da tag
# direto — então precisa ser alcançável de fora.
URL_API_PUBLICA=https://api.conectapet.com.br

# Origens autorizadas no CORS. Nunca "*". Se ficar errado, o navegador bloqueia
# a confirmação de leitura e o tutor NUNCA é avisado, sem nenhum erro visível.
CORS_ORIGENS=https://conectapet.com.br

# ---- Primeiro administrador ------------------------------------------------
# Cadastre-se pelo site como tutor normal, ponha o e-mail aqui e suba de novo:
# a conta é promovida a ADMIN na inicialização. Nenhuma senha passa por aqui.
ADMIN_EMAIL=

# ---- E-mail ----------------------------------------------------------------
# "log" não entrega nada: o tutor não recebe aviso de leitura da tag nem link
# de recuperar senha. Troque por "smtp" quando tiver provedor.
EMAIL_PROVEDOR=log
EMAIL_REMETENTE=ConectaPet <nao-responda@conectapet.com.br>
SMTP_HOST=
SMTP_PORTA=587
SMTP_USUARIO=
SMTP_SENHA=

# ---- Fotos -----------------------------------------------------------------
# "local" grava em disco. Com o volume do compose sobrevive a redeploy, mas não
# sobrevive a trocar de máquina. Em produção de verdade, use "s3".
FOTO_ARMAZENAMENTO=local
FOTO_S3_BUCKET=
# Vazio = AWS. Para Cloudflare R2: https://<conta>.r2.cloudflarestorage.com
FOTO_S3_ENDPOINT=
FOTO_S3_REGIAO=auto
FOTO_S3_CHAVE=
FOTO_S3_SEGREDO=

# ---- Domínios do proxy -----------------------------------------------------
# O Caddy pede e renova o certificado sozinho para estes dois nomes. Antes de
# subir, o DNS de ambos precisa apontar para o IP desta máquina, e as portas
# 80 e 443 precisam estar abertas — é assim que o Let's Encrypt confirma que
# o domínio é seu.
#
# São os mesmos endereços de URL_SITE e URL_API_PUBLICA, sem o "https://".
DOMINIO_SITE=conectapet.com.br
DOMINIO_API=api.conectapet.com.br
